{
  "name": "juriskpro-android",
  "version": "1.0.0",
  "private": true,
  "description": "Build Android APK for JuriskPro using Capacitor and GitHub Actions",
  "scripts": {
    "prepare:web": "node scripts/build-catalogue.cjs && node scripts/vendor-libs.cjs && node scripts/prepare-web.cjs",
    "android:sync": "npm run prepare:web && cap sync android",
    "vendor": "node scripts/vendor-libs.cjs",
    "build:catalogue": "node scripts/build-catalogue.cjs",
    "check:catalogue": "node scripts/build-catalogue.cjs --check",
    "test:models": "node scripts/validate-models.cjs",
    "test": "node scripts/build-catalogue.cjs --check && node scripts/validate-models.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.45.0",
    "jspdf": "2.5.1",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.4.3"
  }
}
