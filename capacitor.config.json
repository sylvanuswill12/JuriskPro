{
  "appId": "com.messtonsconseils.juriskpro",
  "appName": "JuriskPro",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#0D1411",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#0D1411",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}
