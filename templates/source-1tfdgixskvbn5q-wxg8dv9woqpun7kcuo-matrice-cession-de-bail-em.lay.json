,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["sans",26]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["CESSION DE DROITS IMMOBILIERS AGRICOLES","sans",26,5,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":1080,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Le VENDEUR en s’obligeant à toutes les garanties habituelles et de droit en pareille matière, cède à l’ACQUEREUR ce qui est accepté en son nom par Monsieur {{champ_034}} les biens ci-après désignés, savoir :","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tLe droit au bail emphytéotique consenti par l’Etat de COTE D’IVOIRE au VENDEUR aux termes d’un acte administratif en date à {{lieu_acte_administratif}} du {{champ_035}} mil, pour une durée de VINGT CINQ ans à compter du {{champ_036}}, portant sur un terrain de {{champ_037}} faisant l’objet du Titre Foncier numéro {{champ_038}} de la Circonscription Foncière de {{champ_039}}, et ce, moyennant un loyer annuel de {{champ_040}} FRANCS, ({{champ_041}} FRANCS CFA par hectare et par an) payable à la Caisse du Chef de services des Recettes Domaniales chaque année d’avance.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tMention de ce bail dont un exemplaire original demeurera annexé aux présentes après mention, sera fait sur les registres de la propriété Foncière avant la publication des présentes.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tEnsemble les constructions et bâtiments édifiés sur le terrain consistant en des bâtiments en dur ","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tTel que le tout existe avec tous droits y attachés, notamment tous immeubles par destination sans aucune exception ni réserve, non ici plus amplement décrit à la demande des parties, Monsieur {{champ_042}} ès-qualités dclarant bien connaître les biens objet du bail emphytéotique cédé.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["PROPRIETE – JOUISSANCE ","sans",26,5,"000000"]],"e":["sans",26]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tL’ACQUEREUR aura la pleine propriété des biens cédés à compter de ce jour.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tIl en aura la jouissance par la prise de possession réelle et la libre disposition à compter du {{champ_043}}.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["CHARGES ET CONDITIONS GENERALES","sans",26,5,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tLa cession est consentie et acceptée sous les conditions habituelles et de droit en pareille matière et notamment sous celles suivantes que Monsieur {{champ_044}} oblige l’ACQUEREUR à exécuter et accomplir, savoir :","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\t1°- L’ACQUEREUR prendra les biens cédés dans leur état actuel sans pouvoir élever de réclamation ni exiger une réduction du prix ci-après fixé pour quelque cause que ce soit, notamment pour mauvais état du sol, du sous-sol, des constructions, des fruits pendnats, etc {{champ_001}}","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\t2°- L’ACQUEREUR souffrira les servitudes passives, grevant les biens vendus et bénéficiera de celles actives s’il en existe, le tout à ses risques et périls sans recours contre le VENDEUR et sans que la présentes clause puisse conférer à des tiers plus de droits qu’ils justifieraient en avoir en vertu de tous titres réguliers ou de la loi.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tA ce sujet, le VENDEUR déclare qu’il n’a laissé acquérir aucune servitude particulière au profit de qui que ce soit et qu’à sa connaissance il n’en existe pas d’autres que celles résultant de la situation naturelles des lieux.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\t3°- L’ACQUEREUR acquittera à compter de l’entrée en jouissance, les impôts, charges et contributions, de toutes natures afférents aux biens cédés.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\t4°- L’ACQUEREUR paiera tous les frais, droits et émoluments des présentes, ceux de leurs suites et conséquences.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["CONDITIONS PARTICULIERES","sans",26,5,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["\tL’ACQUEREUR exécutera à compter de l’entrée en jouissance, aux lieu et place du VENDEUR, toutes les charges et obligations du bail emphytéotique sus-analysés ; il paiera exactement à son chéance le loyer et fera son affaire personnelle de la remise des lieux en fin de bail ; le tout de manière à ne donner lieu à aucun recours contre le VENDEUR.","sans",26,0,"000000"]],"e":["sans",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"e":["sans",26]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[1080,"l",""]],"r":[["PRIX","sans",26,5,"000000"]],"e":["sa