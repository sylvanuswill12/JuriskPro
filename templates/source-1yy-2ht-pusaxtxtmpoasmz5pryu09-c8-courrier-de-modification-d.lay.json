{"v":1,"page":{"w":11906,"h":16838,"mt":1417,"mb":1417,"ml":1417,"mr":566,"hd":708,"fd":708,"gt":0},"tab":708,"body":[{"t":"p","al":"c","il":5664,"ir":0,"fl":-5664,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[6300,"l",""]],"r":[["                                                                              ABIDJAN, le 13 Mai 2016","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["\t\t\t\t\t\t\t\t","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":5664,"ir":0,"fl":-5664,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[6300,"l",""]],"r":[["                                                                                                        ","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"l","il":6096,"ir":0,"fl":-6096,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[6300,"l",""]],"r":[["                                                                                            ","gothic",24,0,""],["Mme {{nom_salarie}} ","gothic",24,1,""]],"e":["gothic",24]},{"t":"p","al":"l","il":6096,"ir":0,"fl":-6096,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[6300,"l",""]],"r":[["\tnée {{nom_naissance_salarie}} A. {{prenom_salarie}}","gothic",24,1,""]],"e":["gothic",24]},{"t":"p","al":"j","il":6096,"ir":0,"fl":-5664,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[6300,"l",""]],"r":[["\t","gothic",24,0,""],["Secrétaire","gothic",24,1,""]],"e":["gothic",24]},{"t":"p","al":"j","il":5664,"ir":0,"fl":-5664,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[6300,"l",""]],"e":["gothic",24]},{"t":"p","al":"j","il":6096,"ir":0,"fl":-6096,"sb":0,"sa":0,"ln":[240,"a"],"tb":[[6300,"l",""]],"r":[["\t","gothic",24,1,""],["ABIDJAN","gothic",24,5,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"kn":1,"r":[["Nos réf : {{reference_etude}} 1776/2016 \t\t\t","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Objet","gothic",24,5,""],[" : ","gothic",24,0,""],["Modification de contrat de travail","gothic",24,1,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Madame {{partie_2}},","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Faisant suite à notre entretien du 09 courant, je vous confirme la proposition de la modification de votre contrat de travail pour le poste d’archiviste.","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["En effet, les années passées au secrétariat vous ont permis de connaitre les clients et l’historique de leurs dossiers. Le poste d’archiviste n’étant pas encore pourvu au sein de l’Etude, j’ai donc légitimement souhaité que vous l’occupiez, étant donné que l’une de vos tâches au secrétariat consiste en l’archivage des dossiers.","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["En outre, étant l’une des plus anciennes, vous êtes qualifiée pour occuper ce poste et s’il y a lieu, vous pourriez compléter vos acquis par une formation.","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Aussi, cette modification de votre contrat n’entraine pas de modifications salariales, ni de vos horaires.","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"cx":1,"ps":"Paragraphedeliste","r":[["Si la présente retient votre agrément, je vous serai reconnaissante de bien vouloir signer le document précédé de la mention « BON POUR ACCORD ». Dans lequel cas, cette modification sera effective à compter du ","gothic",24,0,""],["Mardi {{date_acte}}","gothic",24,1,""],[".","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Vous en souhaitant bonne réception,","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Je vous prie de croire, Madame {{partie_2}}, à l’assurance de mes sentiments dévoués.","gothic",24,0,""]],"e":["gothic",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"r","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",26]},{"t":"p","al":"r","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",26]},{"t":"p","al":"r","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Me {{notaire_nom}} A. {{prenom_notaire}}","gothic",26,5,""]],"e":["gothic",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["gothic",24]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["serif",24]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["serif",24]}],"fonts":["gothic","serif"]}