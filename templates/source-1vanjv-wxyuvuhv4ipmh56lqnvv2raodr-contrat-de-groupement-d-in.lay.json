{"v":1,"page":{"w":11906,"h":16838,"mt":1417,"mb":1417,"ml":1417,"mr":1417,"hd":708,"fd":708,"gt":0},"tab":708,"body":[{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["CONTRAT DE GROUPEMENT D’INTERET ECONOMIQUE","garamond",32,1,""]],"e":["garamond",32]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"e":["garamond",32]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Entre :","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["- M {{champ_001}} ","garamond",26,0,""],["(nom, raison sociale ou dénomination sociale, forme juridique, adresse domicile ou siège social, numéro registre du commerce et du crédit mobilier)","garamond",26,2,"FF0000"],[" ;","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["- M {{champ_002}} ","garamond",26,0,""],["(nom, raison sociale ou dénomination sociale, forme juridique, adresse domicile ou siège social, numéro registre du commerce et du crédit mobilier)","garamond",26,2,"FF0000"],[" ;","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["- etc {{champ_003}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Il  a été convenu et arrêté la création d’un Groupement d’intérêt Economique dont le but exclusif est de mettre en œuvre tous les moyens propres à faciliter ou à développer leur activité économique, à améliorer ou à accroître les résultats de cette activité ","garamond",26,0,""],["( exposer l’activité des membres du Groupement d’intérêt Economique)","garamond",26,2,"FF0000"],[".","garamond",26,2,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Les soussignés établissent le présent contrat constitutif de leur groupement.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE Premier : Forme du Groupement ","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Les soussignés décident de créer un Groupement d’intérêt Economique (GIE) régi par les dispositions de l’Acte Uniforme de l’OHADA relatif au Droit des Sociétés Commerciales et du Groupement d’intérêt Economique.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Conformément audit Acte Uniforme, ce Groupement jouit de la personnalité morale et de la pleine capacité à compter de son immatriculation au Registre du Commerce et du Crédit Mobilier.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 2 : Dénomination ","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Le Groupement d’Intérêt Economique a pour dénomination « {{champ_004}} ».","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Les actes et documents émanant du Groupement d’Intérêt Economique et destinés aux tiers, notamment les lettres, factures, annonces et publications diverses doivent indiquer lisiblement la dénomination du groupement suivie des mots « Groupement d’Intérêt Economique » ou du sigle « GIE ».","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 3 : Objet ","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Constitué dans le but de mettre en œuvre tous les moyens propres à faciliter ou à développer l’activité économique de ses membres, à améliorer ou à accroitre les résultats de cette activité, le groupement a pour objet :","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["-","garamond",26,0,""],["{{champ_058}}","garamond",26,2,"FF0000"]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["-  {{champ_005}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["-  {{champ_006}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Et généralement, toutes opérations mobilières ou immobilières se rattachant à cet objet ou susceptibles d’aider à sa réalisation.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 4 : Siège du Groupement d’Intérêt Economique","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Le siège du Groupement d’Intérêt Economique est fixé à ","garamond",26,0,""],["(n° rue,  rue, ville, pays)","garamond",26,2,"FF0000"],[".","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Il pourra être transféré :","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["- en tout autre endroit de la même ville sur simple décision de son Conseil d’Administration, lequel  pourra ainsi modifier le contrat dans ce sens ;","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["- partout ailleurs, par décision de l’Assemblée Générale Extraordinaire aux conditions propres à ce type d’assemblée.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 5 : Exercice","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl"