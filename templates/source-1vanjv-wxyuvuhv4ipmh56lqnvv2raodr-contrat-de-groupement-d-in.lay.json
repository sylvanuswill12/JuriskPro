"],"r":[["L’Assemblée Générale Ordinaire : délibère valablement si {{champ_048}} membres sont présents ou représentés.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Les décisions sont prises à la majorité de {{champ_049}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":720,"ir":0,"fl":-360,"sb":0,"sa":200,"ln":[276,"a"],"cx":1,"ps":"Paragraphedeliste","mk":["•","garamond",26,0,"","tab"],"r":[["L’Assemblée Générale Extraordinaire : délibère valablement si {{champ_050}} membres sont présents ou représentés.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Les décisions sont prises à la majorité de {{champ_051}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 15 : Comptes du Groupement","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Il est mis en place une comptabilité régulière des opérations du Groupement destinée à l’information externecomme à son propre usage, conformément aux dispositions de l’Acte Uniforme relatif au Droit Comptable.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Le Conseil d’Administration  ou l’Administrateur du Groupement établit et arrête les états financiers de synthèse. Il établit un rapport sur les opérations de l’exercice et le soumet ainsi que l’inventaire et les comptes annuels à l’approbation de l’Assemblée Générale dans le délai fixé ci-dessus, après les avoir communiqués au contrôleur de gestion, au contrôleur des comptes, au commissaire aux comptes ","garamond",26,0,""],["(selon le cas)","garamond",26,2,"FF0000"],[".","garamond",26,2,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"tb":[[6912,"l",""]],"r":[["Les comptes annuels, les rapports sur les opérations de l’exercice et les résolutions proposées sont adressées aux membres du Groupement en même temps que leurs convocations. {{champ_063}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 16 : Approbation des résultats","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Le Groupement d’Intérêt Economique ne donne pas lui-même à réalisation et à partage des bénéfices.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["En conséquence, les bénéfices ou pertes deviennent  la propriété des membres ou sont mises à leur charge dès leur constatation.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["La répartition se fera au prorata de la part  de chaque membre dans le capital.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["(Si le Groupement d’Intérêt Economique n’a pas de capital indiquer le prorata qui sera retenu par les membres)","garamond",26,2,"FF0000"],[".","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["L’Assemblée Générale peut décider que {{champ_052}}% du bénéfice revenant à chaque membre pourra être porté sans intérêt au compte courant de ce dernier.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Lorsque ce montant  aura atteint la somme de {{champ_053}} ou le pourcentage de {{champ_054}} % du capital, il cesse d’être obligatoire. Cette somme ainsi portée au compte courant est indisponible jusqu’à {{champ_055}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 17 : Contrôle de la gestion du GIE ","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Le contrôle de la gestion est exercée par un contrôleur ","garamond",26,0,""],["(ou plusieurs)","garamond",26,2,"FF0000"],[" choisis parmi les membres ou en dehors d’eux.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Il est nommé pour {{champ_056}} exercices par l’Assemblée Générale ","garamond",26,0,""],["(Assemblée Générale Ordinaire ou Assemblée Générale Extraordinaire)","garamond",26,2,"FF0000"],["des membres du Groupement d’Intérêt Economique.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Il a pour mission ","garamond",26,0,""],["(préciser l’étendue de la mission du contrôleur  de la gestion et de ses pouvoirs d’investigation)","garamond",26,2,"FF0000"],[".","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Il établit un rapport sur l’accomplissement de sa mission.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Le contrôleur de la gestion est rémunéré comme suit ","garamond",26,0,""],["{{champ_064}}","garamond",26,2,"FF0000"]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["ARTICLE 18 : Contrôle des états financiers","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":200,"ln":[276,"a"],"r":[["Si le Groupement d’Intérêt Economique n’émet des obligations ; le contrôle des états financiers doit être effectué par Commissaire aux comptes, choisi sur la liste officielle des Commissaires aux comptes, désigné pour une durée de six (6)