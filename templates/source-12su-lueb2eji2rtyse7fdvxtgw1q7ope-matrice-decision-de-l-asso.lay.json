]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Les parts nouvelles ainsi créées qui seront assujetties à toutes les dispositions statutaires, seront assimilées aux parts anciennes et porteront jouissances à compter du {{champ_010}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["En conséquence de la résolution qui précède, et sous la condition suspensive de la réalisation définitive de l’augmentation de capital, l’associé unique gérant décide de modifier comme suit les articles {{champ_011}} des statuts.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["garamond",26]},{"t":"p","al":"l","il":1440,"ir":0,"fl":-360,"sb":0,"sa":0,"ln":[240,"a"],"cx":1,"ps":"Paragraphedeliste","mk":["o","mono",26,0,"","tab"],"r":[["Article {{champ_012}}.","garamond",26,5,""],[" : Apports","garamond",26,1,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["garamond",16]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"r":[["Il a été apporté à la société :","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[240,"a"],"e":["garamond",16]},{"t":"p","al":"l","il":720,"ir":0,"fl":-360,"sb":0,"sa":0,"ln":[240,"a"],"cx":1,"ps":"Paragraphedeliste","mk":["-","garamond",26,0,"","tab"],"r":[["Lors de la constitution, la somme de {{champ_013}} FCFA ;","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":720,"ir":0,"fl":-360,"sb":0,"sa":0,"ln":[240,"a"],"cx":1,"ps":"Paragraphedeliste","mk":["-","garamond",26,0,"","tab"],"r":[["Lors de l’augmentation de capital décidée par l’associé unique en date du {{champ_014}}, la somme de {{champ_