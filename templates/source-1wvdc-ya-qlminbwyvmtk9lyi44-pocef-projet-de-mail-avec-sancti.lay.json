,"sa":0,"ln":[276,"a"],"e":["garamond",16]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"r":[["Aussi, je vous invite à vous rapprocher de l’Etude afin d’obtenir les renseignements au vu de procéder à la mise en harmonie de vos statuts.  ","garamond",28,0,""]],"e":["garamond",28]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"e":["garamond",16]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"r":[["Vous en souhaitant bonne réception,","garamond",28,0,""]],"e":["garamond",28]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"e":["garamond",16]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"r":[["Dans l’intervalle,","garamond",28,0,""]],"e":["garamond",28]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"e":["garamond",16]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"r":[["Je vous prie de croire, Monsieur {{partie_1}}, à l’assurance de mes salutations distinguées. ","garamond",28,0,""]],"e":["garamond",28]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"e":["garamond",28]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[276,"a"],"e":["garamond",28]}],"fonts":["garamond"]}