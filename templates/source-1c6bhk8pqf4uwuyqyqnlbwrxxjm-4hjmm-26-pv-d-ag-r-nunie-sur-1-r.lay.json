":0,"sb":0,"sa":0,"ln":[259,"a"],"r":[["Siège social : {{champ_004}}","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[259,"a"],"r":[["{{champ_005}} {{champ_006}}","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[259,"a"],"r":[["{{champ_007}} RCCM {{champ_008}}","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":0,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["PROCES-VERBAL DE L'ASSEMBLEE GENERALE EXTRAORDINAIRE DU {{champ_009}}","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t\t","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t","constantia",24,0,""],["Attention","constantia",24,5,""],[" : {{champ_010}} L’AUSCGIE dans son article 134 prévoit que les décisions de l'assemblée doivent être constatées par un procès-verbal dont les mentions y sont déterminées.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Le {{champ_011}}, à {{champ_012}}, les actionnaires de la Société {{champ_002}} se sont réunis en assemblée générale extraordinaire, {{champ_013}}, sur convocation faite par le Conseil d'administration. ","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Il a été établi une feuille de présence qui a été émargée par chaque membre de l'assemblée en entrant en séance- à laquelle sont annexés les pouvoirs des actionnaires représentés et les formulaires de vote par correspondance.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\tEn cas de présence de Commissaires aux comptes à l'assemblée","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\tCommissaire(s) aux comptes présent(s) à l'assemblée :","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["• {{champ_014}}, Commissaire aux comptes - titulaire- suppléant, régulièrement - convoqué, est présent- convoquée, est présente.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\tEn cas d'absence de Commissaires aux comptes à l'assemblée","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\tCommissaire(s) aux comptes absent(s) à l'assemblée :","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["• {{champ_015}}, Commissaire aux comptes - titulaire- suppléant, régulièrement - convoqué, est absent et excusé- convoquée, est absente et excusée.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\tLa séance est présidée par le Président du Conseil","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t{{champ_016}} préside la séance en sa qualité de - Président- Présidente du Organe d'administration.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\tLa séance est présidée par quelqu'un d'autre","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t{{champ_017}} préside la séance en sa qualité de {{champ_018}}.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["{{champ_019}} et {{champ_020}}, présents et acceptant, représentant tant par eux-mêmes que comme mandataires le plus grand nombre de voix, sont appelés comme scrutateurs.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["{{champ_021}} est - désigné- désignée comme secrétaire.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["La feuille de présence, certifiée sincère et véritable par les membres du bureau, permet de constater que les actionnaires présents, représentés ou ayant voté par correspondance possèdent {{champ_022}} actions, soit – {{champ_023}} % du capital social- {{champ_024}} % des actions ayant droit de vote.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Le Président constate d'après la feuille de présence certifiée exacte par les membres du bureau que les actionnaires présents ou représentés ou votant par correspondance possèdent moins du - quart des actions composant le capital social- quart des actions ayant le droit de vote. En conséquence, faute de réunir le quorum requis, l'assemblée générale ne peut valablement délibérer.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Il déclare qu'une nouvelle assemblée sera convoquée sur le même ordre du jour et qu'un quorum du - cinquième des actions composant le capital social- cinquième des actions ayant le droit de vote est requis pour cette assemblée.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Puis, le Président déclare la séance levée à {{champ_025}}.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["De tout ce que dessus il a été dressé le présent procès-verbal qui, après lecture, a été signé par les membres du bureau.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Le Président de l'assemblée","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["{{champ_026}}\tLe Secrétaire","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["{{champ_027}}\tLes Scrutateurs","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["{{champ_028}}","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["{{champ_029}}","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"