24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Fait à {{champ_036}}","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Le {{champ_037}}","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t\t","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t ","constantia",24,0,""],["Attention","constantia",24,5,""],[" : {{champ_038}} Faire précéder la signature de la mention \"Bon pour pouvoir\".","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"c","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Avis à l'actionnaire","constantia",24,1,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t ","constantia",24,0,""],["Remarque","constantia",24,5,""],[" :","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["1. La procuration donnée pour se faire représenter à une assemblée par un actionnaire est signée par celui-ci et indique ses nom, prénom et domicile, ainsi que le nombre d’actions et de droit de vote. ","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Le mandat est donné pour une seule assemblée. Il peut cependant être donné pour deux assemblées, l'une ordinaire, l'autre extraordinaire, tenues le même jour ou dans un délai de sept jours.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["Le mandat donné pour une assemblée vaut pour les assemblées successives convoquées avec le même ordre du jour.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["2. A défaut d'assister personnellement à l'assemblée, l'actionnaire peut choisir entre l'une des deux formules suivantes :","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["- Donner une procuration à un autre actionnaire ou à son conjoint;","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["- Voter par correspondance ;","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["3. En aucun cas, l'actionnaire ne peut retourner à la Société à la fois la formule de procuration et le formulaire de vote par correspondance.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["4. En cas de retour à la fois de la formule de procuration et du formulaire de vote par correspondance, la formule de procuration sera prise en considération, sous réserve des votes exprimés dans le formulaire de vote par correspondance.","constantia",24,0,""]],"e":["constantia",24]},{"t":"p","al":"j","il":0,"ir":0,"fl":0,"sb":0,"sa":160,"ln":[259,"a"],"r":[["\t","constantia",24,0,""],["Remarque","constantia",24,5,""],[" : {{champ_039}} En pratique, cette mention semble devenue caduque puisque la formule de procuration et le formulaire de vote à distance peuvent être établis sur le même document.","co