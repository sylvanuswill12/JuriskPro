"garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[["Nous vous demandons de bien vouloir procéder à ce règlement par tous moyens à votre convenance au plus tard le {{champ_008}}, délai fixé par le conseil d’administration (ou l’administrateur général).","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[["Nous vous rappelons que les sommes non libérées dans ledit délai seront productives de l’intérêt légal sans préjudice de dommages et intérêts s’il y a lieu.","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[["Dans cette attente,","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[["Nous vous prions {{champ_001}}","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[["Le Président du Conseil d’Administration","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[["(Ou l’administrateur général)","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[[" ","garamond",26,0,""]],"e":["garamond",26]},{"t":"p","al":"l","il":0,"ir":0,"fl":0,"sb":280,"sa":280,"ln":[240,"a"],"r":[["{{champ_002}}","garamond",26,0,""]],"e":["garamond",26]}],"fonts":["calibri","garamond"]}